<Window x:Class="CyberSecurityChatbot.NameDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CyberBot – Welcome"
        Height="320" Width="460"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="#0D1117"
        BorderBrush="#30363D"
        BorderThickness="1">

    <Grid Margin="32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Shield + title -->
        <StackPanel Grid.Row="0" HorizontalAlignment="Center" Margin="0,0,0,16">
            <TextBlock Text="🛡️"
                       FontSize="42"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,8"/>
            <TextBlock Text="CyberBot"
                       Foreground="#00D4FF"
                       FontSize="22"
                       FontWeight="Bold"
                       FontFamily="Consolas"
                       HorizontalAlignment="Center"/>
            <TextBlock Text="Cybersecurity Awareness Assistant"
                       Foreground="#8B949E"
                       FontSize="12"
                       FontFamily="Consolas"
                       HorizontalAlignment="Center"/>
        </StackPanel>

        <!-- Divider -->
        <Border Grid.Row="1"
                Height="1"
                Background="#30363D"
                Margin="0,0,0,20"/>

        <!-- Prompt label -->
        <TextBlock Grid.Row="2"
                   Text="Please enter your name to get started:"
                   Foreground="#E6EDF3"
                   FontSize="13"
                   FontFamily="Consolas"
                   Margin="0,0,0,10"/>

        <!-- Name input -->
        <Border Grid.Row="3"
                Background="#1C2333"
                CornerRadius="8"
                BorderBrush="#30363D"
                BorderThickness="1"
                Margin="0,0,0,20"
                Padding="12,8">
            <TextBox x:Name="NameBox"
                     Background="Transparent"
                     Foreground="#E6EDF3"
                     CaretBrush="#00D4FF"
                     BorderThickness="0"
                     FontSize="14"
                     FontFamily="Consolas"
                     MaxLength="40"
                     KeyDown="NameBox_KeyDown"/>
        </Border>

        <!-- Error message -->
        <TextBlock x:Name="ErrorText"
                   Grid.Row="4"
                   Text="⚠️ Please enter your name before continuing."
                   Foreground="#FF6B6B"
                   FontSize="11"
                   FontFamily="Consolas"
                   Visibility="Collapsed"
                   Margin="0,0,0,8"/>

        <!-- Start button -->
        <Button Grid.Row="4"
                Content="Start Chatting ➤"
                Click="StartBtn_Click"
                Margin="0,8,0,0"
                Padding="20,10"
                Background="#00D4FF"
                Foreground="#0D1117"
                FontWeight="Bold"
                FontSize="14"
                FontFamily="Consolas"
                BorderThickness="0"
                Cursor="Hand"
                HorizontalAlignment="Stretch">
            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}"
                            CornerRadius="8"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="#00B8D9"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Button.Template>
        </Button>
    </Grid>
</Window>